/dts-v1/;

/* Bootloader installs ATF here (BL31 resident region, ~256 KiB). */
/memreserve/ 0x80000000 0x88000;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7563.dtsi"

/ {
	model = "Airoha AN7563 Evaluation Board";
	compatible = "airoha,an7563-evb", "airoha,an7563", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&snfi {
	status = "okay";
};

&spi_nand {
	airoha,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x0 0x7c000>;
			read-only;
		};

		partition@1 {
			label = "u-boot-env";
			reg = <0x7c000 0x4000>;
		};

		partition@2 {
			label = "art";
			reg = <0x80000 0x40000>;
			read-only;
		};

		partition@3 {
			compatible = "denx,fit";
			label = "firmware";
			reg = <0xc0000 0x4000000>;
		};
	};
};

/*
 * Ethernet bring-up: AN7563 RFB and Xiaomi BE5000 both use the on-chip
 * 5-port Gigabit Switch behind GDM1; neither board wires an external
 * AN8811H 2.5G PHY (BE5000 reaches the 2.5G uplink through the XPON
 * stack, RFB has no uplink PHY). The eth / qdma / mdio / gsw_phy
 * skeleton lives in an7563.dtsi - enable here per board.
 *
 * NOTE: on the first AN7563 RFB boot the airoha_eth driver passes
 * reset_control_bulk_get / hw_init / qdma_init successfully but then
 * panics inside for_each_child_of_node() with a corrupted OF
 * property->name pointer. The OF tree itself looks correct in dtb
 * hex dump and the same driver path works on AN7581 hardware, so
 * this is most likely an AArch32 ABI / sizeof corner case in the
 * driver rather than a DT problem.
 *
 * Until the panic is root-caused, keep the ethernet block disabled
 * here so the board still boots all the way to a shell - readers
 * can flip these to "okay" once a fix is in. The SoC-level skeleton
 * lives in an7563.dtsi and stays intact regardless.
 */
&eth {
	status = "disabled";
};

&gdm1 {
	status = "disabled";
};

&switch {
	status = "disabled";
};

&gsw_port1 {
	label = "lan1";
	status = "disabled";
};

&gsw_port2 {
	label = "lan2";
	status = "disabled";
};

&gsw_port3 {
	label = "lan3";
	status = "disabled";
};

&gsw_port4 {
	label = "lan4";
	status = "disabled";
};

&gsw_phy1 {
	status = "disabled";
};

&gsw_phy2 {
	status = "disabled";
};

&gsw_phy3 {
	status = "disabled";
};

&gsw_phy4 {
	status = "disabled";
};
