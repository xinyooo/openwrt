From: Ray Liu <ray.xy.liu@gmail.com>
Date: Thu, 14 May 2026 00:20:00 +0800
Subject: [PATCH] net: airoha: AN7563 eth soc-data, PPE flush skip, full ops

Real-hardware iteration on the AN7563 RFB:

  v4 (1163c87b88) booted cleanly through airoha_probe(), the
  airoha_ppe_flush_sram_entries() workaround prevented the silent
  slab corruption, mt7530 DSA enumerated lan1..lan4 with the four
  internal GE PHYs at MDIO addresses 9..12, and "DSA: tree 0 setup"
  succeeded.

  Calling "ip link set lan1 up" however jumped to PC=0 with
  LR=airoha_dev_open+0x68 -> airoha_set_vip_for_gdm_port():
       vip_port = eth->soc->ops.get_vip_port(port, port->nbq);
  because an7563_soc_data did not initialise the .ops callbacks.

AN7563 silicon shares the EN7581 frame-engine and source-port
encoding (verified again against the GPL en7523.dtsi and the Xiaomi
BE5000 vendor DTS), so reuse the EN7581 get_src_port_id /
get_vip_port helpers verbatim. Update an7563_soc_data accordingly.

Together with patch v4 (the SoC quirk that skips the PPE
flush_sram_entries) this is enough to bring the eth / mt7530 / lan*
stack live on AArch32 AN7563.

Patch series so far:
  v1   add airoha,an7563-eth + num_ppe=1                  (probe OK)
  v2   add bisect skip knobs                              (still slab corruption)
  v3   foe alloc instrumentation + flush_sram skip knob   (cause narrowed)
  v4   permanent SoC quirk: skip flush_sram_entries       (probe + DSA bring-up)
  v5   wire .ops.get_src_port_id / .get_vip_port          (this commit)

Signed-off-by: Ray Liu <ray.xy.liu@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -18,6 +18,34 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+static bool airoha_skip_fe_init;
+module_param(airoha_skip_fe_init, bool, 0444);
+MODULE_PARM_DESC(airoha_skip_fe_init,
+		 "AN7563 debug: skip airoha_fe_init() in airoha_hw_init()");
+
+static bool airoha_skip_qdma_init;
+module_param(airoha_skip_qdma_init, bool, 0444);
+MODULE_PARM_DESC(airoha_skip_qdma_init,
+		 "AN7563 debug: skip airoha_qdma_init() per QDMA bank");
+
+static bool airoha_skip_ppe_init;
+module_param(airoha_skip_ppe_init, bool, 0444);
+MODULE_PARM_DESC(airoha_skip_ppe_init,
+		 "AN7563 debug: skip airoha_ppe_init() in airoha_hw_init() "
+		 "(default 0 - PPE now runs by default; the AN7563 silicon"
+		 " hang has been narrowed down to flush_sram_entries(), see"
+		 " airoha_ppe_skip_flush_sram)");
+
+/* keep the AN7563 debug knobs as escape hatches; the production
+ * default for AN7563 lives in an7563_soc_data.ppe_skip_flush_sram.
+ */
+bool airoha_force_flush_sram;
+EXPORT_SYMBOL(airoha_force_flush_sram);
+module_param(airoha_force_flush_sram, bool, 0444);
+MODULE_PARM_DESC(airoha_force_flush_sram,
+		 "AN7563 debug: force airoha_ppe_flush_sram_entries() even"
+		 " when the SoC data says skip (use only for re-bisecting)");
+
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
 	return readl(base + offset);
@@ -1497,38 +1525,60 @@ static int airoha_hw_init(struct platfor
 {
 	int err, i;
 
+	dev_info(eth->dev, "AN7563 dbg: hw_init enter\n");
 	/* disable xsi */
 	err = reset_control_bulk_assert(eth->soc->num_xsi_rsts, eth->xsi_rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: xsi assert ok\n");
 
 	err = reset_control_bulk_assert(ARRAY_SIZE(eth->rsts), eth->rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: fe/pdma/qdma assert ok\n");
 
 	err = reset_control_bulk_deassert(eth->soc->num_xsi_rsts, eth->xsi_rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: xsi deassert ok\n");
 
 	msleep(20);
 	err = reset_control_bulk_deassert(ARRAY_SIZE(eth->rsts), eth->rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: fe/pdma/qdma deassert ok\n");
 
 	msleep(20);
-	err = airoha_fe_init(eth);
-	if (err)
-		return err;
+	if (airoha_skip_fe_init) {
+		dev_info(eth->dev, "AN7563 dbg: fe_init SKIPPED\n");
+	} else {
+		err = airoha_fe_init(eth);
+		if (err)
+			return err;
+		dev_info(eth->dev, "AN7563 dbg: fe_init ok\n");
+	}
 
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		if (airoha_skip_qdma_init) {
+			dev_info(eth->dev,
+				 "AN7563 dbg: qdma_init[%d] SKIPPED\n", i);
+			continue;
+		}
 		err = airoha_qdma_init(pdev, eth, &eth->qdma[i]);
+		dev_info(eth->dev, "AN7563 dbg: qdma_init[%d] -> %d\n", i, err);
 		if (err)
 			goto error;
 	}
 
-	err = airoha_ppe_init(eth);
-	if (err)
-		goto error;
+	if (airoha_skip_ppe_init) {
+		dev_info(eth->dev, "AN7563 dbg: ppe_init SKIPPED\n");
+	} else {
+		err = airoha_ppe_init(eth);
+		if (err)
+			goto error;
+		dev_info(eth->dev, "AN7563 dbg: ppe_init ok (num_ppe=%d)\n",
+			 eth->soc->num_ppe);
+	}
 
 	set_bit(DEV_STATE_INITIALIZED, &eth->state);
 
@@ -3230,6 +3280,10 @@ static int airoha_probe(struct platform_
 
 	eth->dev = &pdev->dev;
 
+	dev_info(eth->dev,
+		 "AN7563 dbg: probe enter, version=0x%x num_ppe=%d num_xsi_rsts=%d\n",
+		 eth->soc->version, eth->soc->num_ppe, eth->soc->num_xsi_rsts);
+
 	err = dma_set_mask_and_coherent(eth->dev, DMA_BIT_MASK(32));
 	if (err) {
 		dev_err(eth->dev, "failed configuring DMA mask\n");
@@ -3269,6 +3323,7 @@ static int airoha_probe(struct platform_
 		dev_err(eth->dev, "failed to get bulk xsi reset lines\n");
 		return err;
 	}
+	dev_info(eth->dev, "AN7563 dbg: xsi_rsts bulk_get ok\n");
 
 	eth->napi_dev = alloc_netdev_dummy(0);
 	if (!eth->napi_dev)
@@ -3282,9 +3337,12 @@ static int airoha_probe(struct platform_
 	err = airoha_hw_init(pdev, eth);
 	if (err)
 		goto error_netdev_free;
+	dev_info(eth->dev, "AN7563 dbg: hw_init complete\n");
 
-	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
 		airoha_qdma_start_napi(&eth->qdma[i]);
+		dev_info(eth->dev, "AN7563 dbg: qdma_start_napi[%d] ok\n", i);
+	}
 
 	for_each_child_of_node(pdev->dev.of_node, np) {
 		if (!of_device_is_compatible(np, "airoha,eth-mac"))
@@ -3293,16 +3351,19 @@ static int airoha_probe(struct platform_
 		if (!of_device_is_available(np))
 			continue;
 
+		dev_info(eth->dev, "AN7563 dbg: alloc_gdm_port for %pOFn\n", np);
 		err = airoha_alloc_gdm_port(eth, np);
 		if (err) {
 			of_node_put(np);
 			goto error_napi_stop;
 		}
 	}
+	dev_info(eth->dev, "AN7563 dbg: all alloc_gdm_port done\n");
 
 	err = airoha_register_gdm_devices(eth);
 	if (err)
 		goto error_napi_stop;
+	dev_info(eth->dev, "AN7563 dbg: register_gdm_devices done\n");
 
 	return 0;
 
@@ -3486,9 +3547,41 @@ static const struct airoha_eth_soc_data
 	},
 };
 
+/*
+ * AN7563 / AN7552 silicon shares the EN7581 frame-engine, QDMA, GSW and
+ * chip-SCU register map (cross-checked against the vendor en7523.dtsi
+ * GPL drop and the Xiaomi BE5000 vendor DTS), but exposes a smaller NPU
+ * cluster - 2 RV32 cores instead of EN7581's 8. Per the NPU core / PPE
+ * engine pairing convention this likely means only a single PPE
+ * instance is wired on AN7563. Running the EN7581 num_ppe=2 path on
+ * AArch32 AN7563 hardware produced random kernel slab corruption inside
+ * airoha_probe(); use num_ppe=1 here and ship a dedicated compatible
+ * so DTS does not need to fall back to "airoha,en7581-eth".
+ */
+static const struct airoha_eth_soc_data an7563_soc_data = {
+	.version = 0x7563,
+	.xsi_rsts_names = en7581_xsi_rsts_names,
+	.num_xsi_rsts = ARRAY_SIZE(en7581_xsi_rsts_names),
+	.num_ppe = 1,
+	.ppe_skip_flush_sram = true,
+	/*
+	 * AN7563 silicon shares the EN7581 frame-engine and source-port
+	 * encoding (verified against the GPL en7523.dtsi and Xiaomi
+	 * BE5000 vendor DTS), so reuse the EN7581 get_src_port_id /
+	 * get_vip_port helpers. Leaving these NULL caused PC=0 jumps
+	 * inside airoha_set_vip_for_gdm_port() when "ip link set lan*
+	 * up" walked dsa_user_open() -> airoha_dev_open().
+	 */
+	.ops = {
+		.get_src_port_id = airoha_en7581_get_src_port_id,
+		.get_vip_port = airoha_en7581_get_vip_port,
+	},
+};
+
 static const struct of_device_id of_airoha_match[] = {
 	{ .compatible = "airoha,en7581-eth", .data = &en7581_soc_data },
 	{ .compatible = "airoha,an7583-eth", .data = &an7583_soc_data },
+	{ .compatible = "airoha,an7563-eth", .data = &an7563_soc_data },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, of_airoha_match);
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -583,6 +583,17 @@ struct airoha_eth_soc_data {
 	const char * const *xsi_rsts_names;
 	int num_xsi_rsts;
 	int num_ppe;
+	/*
+	 * AN7563 silicon on AArch32 hangs the kernel after the 8192
+	 * REG_PPE_RAM_ENTRY / REG_PPE_RAM_CTRL writes done by
+	 * airoha_ppe_flush_sram_entries(): the PPE engine ends up
+	 * silently DMAing into random kernel slab pages. The flush
+	 * is only needed when PPE is actually brought online via
+	 * airoha_ppe_offload_setup() / airoha_ppe_hw_init(), and
+	 * the firmware leaves the SRAM in reset state on power-on,
+	 * so on AN7563 we can safely skip it.
+	 */
+	bool ppe_skip_flush_sram;
 	struct {
 		int (*get_src_port_id)(struct airoha_gdm_port *port, int nbq);
 		u32 (*get_vip_port)(struct airoha_gdm_port *port, int nbq);
@@ -656,6 +667,11 @@ static inline bool airoha_is_7581(struct
 	return eth->soc->version == 0x7581;
 }
 
+static inline bool airoha_is_7563(struct airoha_eth *eth)
+{
+	return eth->soc->version == 0x7563;
+}
+
 static inline bool airoha_is_7583(struct airoha_eth *eth)
 {
 	return eth->soc->version == 0x7583;
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1537,6 +1537,8 @@ void airoha_ppe_put_dev(struct airoha_pp
 }
 EXPORT_SYMBOL_GPL(airoha_ppe_put_dev);
 
+extern bool airoha_force_flush_sram;
+
 int airoha_ppe_init(struct airoha_eth *eth)
 {
 	int foe_size, err, ppe_num_stats_entries;
@@ -1546,6 +1548,7 @@ int airoha_ppe_init(struct airoha_eth *e
 	ppe = devm_kzalloc(eth->dev, sizeof(*ppe), GFP_KERNEL);
 	if (!ppe)
 		return -ENOMEM;
+	dev_info(eth->dev, "AN7563 dbg: ppe alloc struct ok ppe=%p\n", ppe);
 
 	ppe->dev.ops.setup_tc_block_cb = airoha_ppe_setup_tc_block_cb;
 	ppe->dev.ops.check_skb = airoha_ppe_check_skb;
@@ -1555,16 +1558,23 @@ int airoha_ppe_init(struct airoha_eth *e
 
 	ppe_num_entries = airoha_ppe_get_total_num_entries(ppe);
 	foe_size = ppe_num_entries * sizeof(struct airoha_foe_entry);
+	dev_info(eth->dev,
+		 "AN7563 dbg: ppe foe alloc start, entries=%u foe_size=%d\n",
+		 ppe_num_entries, foe_size);
 	ppe->foe = dmam_alloc_coherent(eth->dev, foe_size, &ppe->foe_dma,
 				       GFP_KERNEL);
 	if (!ppe->foe)
 		return -ENOMEM;
+	dev_info(eth->dev,
+		 "AN7563 dbg: ppe foe alloc ok foe=%p foe_dma=0x%llx\n",
+		 ppe->foe, (unsigned long long)ppe->foe_dma);
 
 	ppe->foe_flow = devm_kzalloc(eth->dev,
 				     ppe_num_entries * sizeof(*ppe->foe_flow),
 				     GFP_KERNEL);
 	if (!ppe->foe_flow)
 		return -ENOMEM;
+	dev_info(eth->dev, "AN7563 dbg: ppe foe_flow alloc ok\n");
 
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries > 0) {
@@ -1574,16 +1584,32 @@ int airoha_ppe_init(struct airoha_eth *e
 						     GFP_KERNEL);
 		if (!ppe->foe_stats)
 			return -ENOMEM;
+		dev_info(eth->dev,
+			 "AN7563 dbg: ppe foe_stats alloc ok stats=%d\n",
+			 ppe_num_stats_entries);
+	} else {
+		dev_info(eth->dev, "AN7563 dbg: ppe foe_stats skipped (none)\n");
 	}
 
 	ppe->foe_check_time = devm_kzalloc(eth->dev, ppe_num_entries,
 					   GFP_KERNEL);
 	if (!ppe->foe_check_time)
 		return -ENOMEM;
+	dev_info(eth->dev, "AN7563 dbg: ppe foe_check_time alloc ok\n");
 
-	err = airoha_ppe_flush_sram_entries(ppe);
-	if (err)
-		return err;
+	if (eth->soc->ppe_skip_flush_sram && !airoha_force_flush_sram) {
+		dev_info(eth->dev,
+			 "AN7563 dbg: airoha_ppe_flush_sram_entries SKIPPED (SoC quirk)\n");
+	} else {
+		dev_info(eth->dev,
+			 "AN7563 dbg: airoha_ppe_flush_sram_entries enter\n");
+		err = airoha_ppe_flush_sram_entries(ppe);
+		dev_info(eth->dev,
+			 "AN7563 dbg: airoha_ppe_flush_sram_entries done err=%d\n",
+			 err);
+		if (err)
+			return err;
+	}
 
 	err = rhashtable_init(&eth->flow_table, &airoha_flow_table_params);
 	if (err)
