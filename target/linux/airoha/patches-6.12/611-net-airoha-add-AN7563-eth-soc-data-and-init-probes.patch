From: Ray Liu <ray.xy.liu@gmail.com>
Date: Wed, 13 May 2026 23:30:00 +0800
Subject: [PATCH] net: airoha: AN7563 eth soc-data, probe tracing, init bisect

The previous test boot (commit 6c94e66fc4 / patch 611 v1) confirmed
the AN7563 RFB still crashes after airoha_probe() runs all init
phases successfully. dev_info trace landed in dmesg as:

  AN7563 dbg: probe enter, version=0x7563 num_ppe=1 num_xsi_rsts=4
  AN7563 dbg: xsi_rsts bulk_get ok
  AN7563 dbg: hw_init enter
  AN7563 dbg: xsi assert ok
  AN7563 dbg: fe/pdma/qdma assert ok
  AN7563 dbg: xsi deassert ok
  AN7563 dbg: fe/pdma/qdma deassert ok
  AN7563 dbg: fe_init ok
  AN7563 dbg: qdma_init[0] -> 0
  AN7563 dbg: qdma_init[1] -> 0
  AN7563 dbg: ppe_init ok (num_ppe=1)
  AN7563 dbg: hw_init complete
  AN7563 dbg: qdma_start_napi[0] ok
  AN7563 dbg: qdma_start_napi[1] ok
  AN7563 dbg: alloc_gdm_port for ethernet
  ---- 8< ---- buddy allocator returns an unmapped page during
              devm_alloc_etherdev_mqs() / kernel_init_pages()

So num_ppe=1 alone is not sufficient - a hardware engine programmed
in fe_init / qdma_init[0] / qdma_init[1] / ppe_init is still doing
silent DMA somewhere that corrupts buddy free pages.

Add three module parameters so the next test boot can bisect which
init phase is responsible, and default airoha_skip_ppe_init=true
(top suspect: 2 MiB FOE table DMA + PPE2 reg writes). User can
re-enable PPE on the kernel command line or disable other phases
the same way:

  airoha_eth.airoha_skip_ppe_init=0      # default = 1 in this patch
  airoha_eth.airoha_skip_fe_init=1       # default = 0
  airoha_eth.airoha_skip_qdma_init=1     # default = 0

Keep the dev_info probe trace from v1. Bring back the
airoha_is_7563() helper and the an7563_soc_data entry with
num_ppe=1.

Signed-off-by: Ray Liu <ray.xy.liu@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -18,6 +18,22 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+static bool airoha_skip_fe_init;
+module_param(airoha_skip_fe_init, bool, 0444);
+MODULE_PARM_DESC(airoha_skip_fe_init,
+		 "AN7563 debug: skip airoha_fe_init() in airoha_hw_init()");
+
+static bool airoha_skip_qdma_init;
+module_param(airoha_skip_qdma_init, bool, 0444);
+MODULE_PARM_DESC(airoha_skip_qdma_init,
+		 "AN7563 debug: skip airoha_qdma_init() per QDMA bank");
+
+static bool airoha_skip_ppe_init = true;
+module_param(airoha_skip_ppe_init, bool, 0444);
+MODULE_PARM_DESC(airoha_skip_ppe_init,
+		 "AN7563 debug: skip airoha_ppe_init() in airoha_hw_init() "
+		 "(default: true, set 0 to re-enable)");
+
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
 	return readl(base + offset);
@@ -1497,38 +1513,60 @@
 {
 	int err, i;
 
+	dev_info(eth->dev, "AN7563 dbg: hw_init enter\n");
 	/* disable xsi */
 	err = reset_control_bulk_assert(eth->soc->num_xsi_rsts, eth->xsi_rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: xsi assert ok\n");
 
 	err = reset_control_bulk_assert(ARRAY_SIZE(eth->rsts), eth->rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: fe/pdma/qdma assert ok\n");
 
 	err = reset_control_bulk_deassert(eth->soc->num_xsi_rsts, eth->xsi_rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: xsi deassert ok\n");
 
 	msleep(20);
 	err = reset_control_bulk_deassert(ARRAY_SIZE(eth->rsts), eth->rsts);
 	if (err)
 		return err;
+	dev_info(eth->dev, "AN7563 dbg: fe/pdma/qdma deassert ok\n");
 
 	msleep(20);
-	err = airoha_fe_init(eth);
-	if (err)
-		return err;
+	if (airoha_skip_fe_init) {
+		dev_info(eth->dev, "AN7563 dbg: fe_init SKIPPED\n");
+	} else {
+		err = airoha_fe_init(eth);
+		if (err)
+			return err;
+		dev_info(eth->dev, "AN7563 dbg: fe_init ok\n");
+	}
 
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		if (airoha_skip_qdma_init) {
+			dev_info(eth->dev,
+				 "AN7563 dbg: qdma_init[%d] SKIPPED\n", i);
+			continue;
+		}
 		err = airoha_qdma_init(pdev, eth, &eth->qdma[i]);
+		dev_info(eth->dev, "AN7563 dbg: qdma_init[%d] -> %d\n", i, err);
 		if (err)
 			goto error;
 	}
 
-	err = airoha_ppe_init(eth);
-	if (err)
-		goto error;
+	if (airoha_skip_ppe_init) {
+		dev_info(eth->dev, "AN7563 dbg: ppe_init SKIPPED\n");
+	} else {
+		err = airoha_ppe_init(eth);
+		if (err)
+			goto error;
+		dev_info(eth->dev, "AN7563 dbg: ppe_init ok (num_ppe=%d)\n",
+			 eth->soc->num_ppe);
+	}
 
 	set_bit(DEV_STATE_INITIALIZED, &eth->state);
 
@@ -3230,6 +3268,10 @@
 
 	eth->dev = &pdev->dev;
 
+	dev_info(eth->dev,
+		 "AN7563 dbg: probe enter, version=0x%x num_ppe=%d num_xsi_rsts=%d\n",
+		 eth->soc->version, eth->soc->num_ppe, eth->soc->num_xsi_rsts);
+
 	err = dma_set_mask_and_coherent(eth->dev, DMA_BIT_MASK(32));
 	if (err) {
 		dev_err(eth->dev, "failed configuring DMA mask\n");
@@ -3269,6 +3311,7 @@
 		dev_err(eth->dev, "failed to get bulk xsi reset lines\n");
 		return err;
 	}
+	dev_info(eth->dev, "AN7563 dbg: xsi_rsts bulk_get ok\n");
 
 	eth->napi_dev = alloc_netdev_dummy(0);
 	if (!eth->napi_dev)
@@ -3282,9 +3325,12 @@
 	err = airoha_hw_init(pdev, eth);
 	if (err)
 		goto error_netdev_free;
+	dev_info(eth->dev, "AN7563 dbg: hw_init complete\n");
 
-	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
 		airoha_qdma_start_napi(&eth->qdma[i]);
+		dev_info(eth->dev, "AN7563 dbg: qdma_start_napi[%d] ok\n", i);
+	}
 
 	for_each_child_of_node(pdev->dev.of_node, np) {
 		if (!of_device_is_compatible(np, "airoha,eth-mac"))
@@ -3293,16 +3339,19 @@
 		if (!of_device_is_available(np))
 			continue;
 
+		dev_info(eth->dev, "AN7563 dbg: alloc_gdm_port for %pOFn\n", np);
 		err = airoha_alloc_gdm_port(eth, np);
 		if (err) {
 			of_node_put(np);
 			goto error_napi_stop;
 		}
 	}
+	dev_info(eth->dev, "AN7563 dbg: all alloc_gdm_port done\n");
 
 	err = airoha_register_gdm_devices(eth);
 	if (err)
 		goto error_napi_stop;
+	dev_info(eth->dev, "AN7563 dbg: register_gdm_devices done\n");
 
 	return 0;
 
@@ -3486,9 +3535,28 @@
 	},
 };
 
+/*
+ * AN7563 / AN7552 silicon shares the EN7581 frame-engine, QDMA, GSW and
+ * chip-SCU register map (cross-checked against the vendor en7523.dtsi
+ * GPL drop and the Xiaomi BE5000 vendor DTS), but exposes a smaller NPU
+ * cluster - 2 RV32 cores instead of EN7581's 8. Per the NPU core / PPE
+ * engine pairing convention this likely means only a single PPE
+ * instance is wired on AN7563. Running the EN7581 num_ppe=2 path on
+ * AArch32 AN7563 hardware produced random kernel slab corruption inside
+ * airoha_probe(); use num_ppe=1 here and ship a dedicated compatible
+ * so DTS does not need to fall back to "airoha,en7581-eth".
+ */
+static const struct airoha_eth_soc_data an7563_soc_data = {
+	.version = 0x7563,
+	.xsi_rsts_names = en7581_xsi_rsts_names,
+	.num_xsi_rsts = ARRAY_SIZE(en7581_xsi_rsts_names),
+	.num_ppe = 1,
+};
+
 static const struct of_device_id of_airoha_match[] = {
 	{ .compatible = "airoha,en7581-eth", .data = &en7581_soc_data },
 	{ .compatible = "airoha,an7583-eth", .data = &an7583_soc_data },
+	{ .compatible = "airoha,an7563-eth", .data = &an7563_soc_data },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, of_airoha_match);
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -656,6 +656,11 @@
 	return eth->soc->version == 0x7581;
 }
 
+static inline bool airoha_is_7563(struct airoha_eth *eth)
+{
+	return eth->soc->version == 0x7563;
+}
+
 static inline bool airoha_is_7583(struct airoha_eth *eth)
 {
 	return eth->soc->version == 0x7583;
