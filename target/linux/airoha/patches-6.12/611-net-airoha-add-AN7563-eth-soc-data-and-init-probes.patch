+bool airoha_ppe_skip_flush_sram = true;
+EXPORT_SYMBOL(airoha_ppe_skip_flush_sram);
+module_param(airoha_ppe_skip_flush_sram, bool, 0444);
+MODULE_PARM_DESC(airoha_ppe_skip_flush_sram,
